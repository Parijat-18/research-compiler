#!/usr/bin/env python3
"""Wrapper shim for paper-compiler CLI.

Adds the bundled cli/src directory to sys.path so the script works without
`pip install`. Real entry point lives in paper_compiler_cli.cli:main.
"""

import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from paper_compiler_cli.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
